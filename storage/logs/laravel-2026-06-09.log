    \"<span class=sf-dump-key>heading</span>\" => \"<span class=sf-dump-str title=\"69 characters\">Australian Banks Spark Fresh Competition with New Home Loan Rate Cuts</span>\"
    \"<span class=sf-dump-key>banner_heading</span>\" => \"<span class=sf-dump-str title=\"69 characters\">Australian Banks Spark Fresh Competition with New Home Loan Rate Cuts</span>\"
    \"<span class=sf-dump-key>sub_heading</span>\" => \"<span class=sf-dump-str title=\"15 characters\">Property Market</span>\"
    \"<span class=sf-dump-key>slug</span>\" => \"<span class=sf-dump-str title=\"69 characters\">australian-banks-spark-fresh-competition-with-new-home-loan-rate-cuts</span>\"
    \"<span class=sf-dump-key>category</span>\" => \"<span class=sf-dump-str title=\"2 characters\">27</span>\"
