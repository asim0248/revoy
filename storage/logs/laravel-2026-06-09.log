    \"<span class=sf-dump-key>heading</span>\" => \"<span class=sf-dump-str title=\"70 characters\">Off-the-Plan Property Contracts: How Buyers Can Avoid Costly Surprises</span>\"
    \"<span class=sf-dump-key>banner_heading</span>\" => \"<span class=sf-dump-str title=\"70 characters\">Off-the-Plan Property Contracts: How Buyers Can Avoid Costly Surprises</span>\"
    \"<span class=sf-dump-key>sub_heading</span>\" => \"<span class=sf-dump-str title=\"6 characters\">Buying</span>\"
    \"<span class=sf-dump-key>slug</span>\" => \"<span class=sf-dump-str title=\"69 characters\">off-the-plan-property-contracts-how-buyers-can-avoid-costly-surprises</span>\"
    \"<span class=sf-dump-key>category</span>\" => \"<span class=sf-dump-str title=\"2 characters\">10</span>\"
    \"<span class=sf-dump-key>tags</span>\" => \"\"
