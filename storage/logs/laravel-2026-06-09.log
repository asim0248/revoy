    \"<span class=sf-dump-key>banner_heading</span>\" => \"<span class=sf-dump-str title=\"104 characters\">Perth Property Surge 2025: How Lower Rates and Major Investments Are Powering WA&#039;s Next Real Estate Boom</span>\"
